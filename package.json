{
  "name": "qd-paper-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "量子点器件前沿论文每日追踪：自动抓取、提取 DOI、生成中文创新点总结",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "update": "node src/build.mjs",
    "backfill": "node src/build.mjs --days=90",
    "dry": "node src/build.mjs --days=30 --dry-run",
    "no-llm": "node src/build.mjs --days=14 --no-llm",
    "preview": "node scripts/serve.mjs",
    "test": "node --test",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:privacy:history": "node scripts/check-privacy.mjs --history"
  }
}
