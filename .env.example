# 复制这个文件为 .env，然后填入你自己的值。
# .env 已被 .gitignore 忽略，不会进入仓库。
#
# 注意：这个项目是纯静态站点，所有 LLM 调用都只发生在构建期（你的电脑或 GitHub Actions），
# 密钥永远不会被发送到浏览器，也不会出现在 docs/ 目录的任何文件里。

# 必填（若要生成中文创新点总结）。没有它时管线自动降级为 --no-llm：
# 仍然抓取论文、打方向标签、给 DOI 链接，只是没有中文总结。
DEEPSEEK_API_KEY=sk-在这里填入你的密钥

# 可选。OpenAlex / Crossref 的"礼貌池"联系邮箱，填了限流额度更宽松。
CONTACT_EMAIL=you@example.com

# 可选。默认 deepseek-chat。
DEEPSEEK_MODEL=deepseek-chat

# 可选。任何兼容 OpenAI /chat/completions 协议的服务都可以替换。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选。Semantic Scholar 的 API key。不填也能用（匿名限流更严，本项目的请求量很小）。
# 注意：arXiv 源必须靠 Semantic Scholar 把预印本解析成期刊版本，没有它 arXiv 源照样可用，只是更慢。
SEMANTIC_SCHOLAR_API_KEY=

# 可选。SerpApi 的 key，用来启用「Google 学术」这个可选数据源（付费服务）。
# 不填时该源自动跳过，网站只用 OpenAlex / Crossref / Semantic Scholar / arXiv 四个免费源。
SERPAPI_KEY=
